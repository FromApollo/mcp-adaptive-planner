# LLM provider (OpenAI-compatible endpoint)
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-3.6-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# Groq:    LLM_MODEL=llama-3.3-70b-versatile  LLM_BASE_URL=https://api.groq.com/openai/v1
# Mistral: LLM_MODEL=mistral-small-latest      LLM_BASE_URL=https://api.mistral.ai/v1

# Web search (https://tavily.com — free, 1000 req/month, no credit card)
TAVILY_API_KEY=your_tavily_key_here

# Gmail SMTP (use an App Password: myaccount.google.com/apppasswords)
EMAIL_ADDRESS=you@gmail.com
EMAIL_PASSWORD=your_app_password_here
